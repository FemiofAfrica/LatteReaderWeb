{
  "name": "latte-reader-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:spoken-position": "python3 tests/fixtures/generate_spoken_fixture.py && node scripts/spoken-position-smoke.mjs",
    "test:spacing-voices": "node scripts/spacing-voices-smoke.mjs",
    "test:readability-accessibility": "node scripts/readability-accessibility-smoke.mjs",
    "test:reading": "node scripts/reading-quality-smoke.mjs",
    "test:selection": "python3 tests/fixtures/generate_selection_fixture.py && node scripts/selection-quality-smoke.mjs",
    "test:extraction-quality": "node scripts/extraction-quality-probe.mjs && python3 tests/fixtures/inspect_font_mapping.py",
    "test:watch": "vitest",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:mobile": "node scripts/mobile-smoke.mjs",
    "test:layout": "node scripts/layout-sweep.mjs",
    "test:desktop": "python3 tests/fixtures/generate_desktop_fixture.py && node scripts/desktop-console-smoke.mjs",
    "test:rotary": "node scripts/rotary-navigation-smoke.mjs",
    "test:fit": "node scripts/preview-fit-smoke.mjs",
    "test:sticky": "node scripts/sticky-header-smoke.mjs",
    "test:textpanel": "node scripts/preview-text-smoke.mjs",
    "test:workers": "node scripts/worker-audit.mjs",
    "test:diagnostics": "node scripts/diagnostics-smoke.mjs",
    "test:uploads": "node scripts/upload-diagnosis-smoke.mjs",
    "test:diagnostics:sustained": "node scripts/diagnostics-sustained.mjs",
    "test:diagnostics:transport": "node scripts/diagnostics-transport.mjs",
    "test:compatibility": "node scripts/compatibility-smoke.mjs",
    "voice:manifest": "node scripts/stage-misaki-assets.mjs",
    "voice:smoke": "node scripts/misaki-reader-smoke.mjs",
    "narrator:stage": "node scripts/stage-misaki-assets.mjs",
    "test:narrator": "python3 tests/fixtures/generate_misaki_fixture.py && node scripts/misaki-reader-smoke.mjs && node scripts/misaki-controls-smoke.mjs",
    "test:plain-ui": "node scripts/plain-ui-smoke.mjs",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:page-follow": "python3 tests/fixtures/generate_page_follow_fixture.py && node scripts/page-follow-smoke.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.0.1",
    "playwright": "^1.64.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.0.7"
  }
}
